{
	"name": "Dice Roller",
	"short_name": "Dice",
	"description": "A physically simulated 3D dice roller. Any dice, loaded weights, forced results and six tables, all configured through the URL.",
	"id": "./",
	"start_url": "./",
	"scope": "./",
	"display": "fullscreen",
	"display_override": [ "fullscreen", "standalone" ],
	"orientation": "any",
	"background_color": "#06100b",
	"theme_color": "#06100b",
	"categories": [ "games", "entertainment", "utilities" ],
	"icons": [
		{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
		{ "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
		{ "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
		{ "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
	],
	"shortcuts": [
		{ "name": "Full polyhedral set", "url": "./?dice=[4,6,8,10,12,20]", "icons": [ { "src": "icons/icon-192.png", "sizes": "192x192" } ] },
		{ "name": "Two d6", "url": "./?dice=[6,6]", "icons": [ { "src": "icons/icon-192.png", "sizes": "192x192" } ] },
		{ "name": "d20", "url": "./?dice=[20]&background=velvet", "icons": [ { "src": "icons/icon-192.png", "sizes": "192x192" } ] }
	]
}
